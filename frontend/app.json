{
  "expo": {
    "name": "Dubly",
    "slug": "doubly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "doubly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "사진을 공유하기 위해 사진 접근 권한이 필요해요.",
          "cameraPermission": "음식·진행 사진을 촬영하거나 바코드를 스캔하기 위해 카메라 접근 권한이 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "음식·진행 사진을 촬영하거나 바코드를 스캔하기 위해 카메라 접근 권한이 필요해요."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf"
          ]
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "happyeon",
          "project": "doubly"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Doubly",
              "label": "Dubly",
              "description": "함께한 D-day와 우리의 스트릭",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-audio",
      "expo-notifications",
      [
        "@stream-io/video-react-native-sdk",
        {
          "ringing": true,
          "androidMessagingServiceBaseClass": null
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "영상통화를 위해 카메라 접근 권한이 필요해요.",
          "microphonePermission": "통화를 위해 마이크 접근 권한이 필요해요."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "imageWidth": 220,
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doubly.app.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.doubly.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Dubly",
      "shortName": "Dubly",
      "lang": "ko",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "description": "Dubly — 둘이라서, 두 배로. 커플 운동·식단·여행·일상 공유"
    },
    "extra": {
      "eas": {
        "projectId": "0c8c5a85-cdfd-4a54-9f45-c95d6cba079e"
      }
    },
    "owner": "happyeon"
  }
}

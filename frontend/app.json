{
  "expo": {
    "name": "Dubly",
    "slug": "doubly",
    "version": "1.0.8",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0c8c5a85-cdfd-4a54-9f45-c95d6cba079e"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "doubly",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "사진을 공유하기 위해 사진 접근 권한이 필요해요.",
          "cameraPermission": "음식·진행 사진을 촬영하거나 바코드를 스캔하기 위해 카메라 접근 권한이 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "음식·진행 사진을 촬영하거나 바코드를 스캔하기 위해 카메라 접근 권한이 필요해요."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf"
          ]
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "happyeon",
          "project": "doubly"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Doubly",
              "label": "Dubly",
              "description": "함께한 D-day와 우리의 스트릭",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F28472"
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도에서 내 위치를 보여 주기 위해 위치 정보가 필요해요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "지도에서 내 위치를 보여 주는 위치 기능에 함께 들어 있는 권한이에요. Dubly 는 동작 정보를 읽지 않아요.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "받은 사진을 갤러리에 저장하기 위해 사진 접근 권한이 필요해요.",
          "savePhotosPermission": "받은 사진을 갤러리에 저장하기 위해 사진 저장 권한이 필요해요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "광고를 내 관심사에 맞게 보여 드리는 데 쓰여요. 허용하지 않아도 앱은 그대로 쓸 수 있고, 관련 없는 광고가 나와요."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doubly.app.ios",
      "associatedDomains": [
        "applinks:dubly.co.kr"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    "android": {
      "package": "com.doubly.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dubly.co.kr",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Dubly",
      "shortName": "Dubly",
      "lang": "ko",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "description": "Dubly — 둘이라서, 두 배로. 커플 운동·식단·여행·일상 공유"
    },
    "extra": {
      "eas": {
        "projectId": "0c8c5a85-cdfd-4a54-9f45-c95d6cba079e"
      }
    },
    "owner": "happyeon"
  }
}

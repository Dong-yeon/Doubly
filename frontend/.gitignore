# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# 로컬에 받아둔 EAS 빌드 산출물(APK/AAB) — 용량이 커서(수십~백MB) 커밋 금지
build/
*.aab
*.apk

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase Admin SDK 서비스 계정 키 — 관리자 권한 비밀키, 절대 커밋 금지
*firebase-adminsdk*.json

# 백엔드 환경변수 예시 — 실제 값으로 복사해 사용 (export 또는 IDE Run Config)
# docker-compose.yml 기본값 기준

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitto
DB_USERNAME=fitto
DB_PASSWORD=fitto

REDIS_HOST=localhost
REDIS_PORT=6379

# 운영에서는 반드시 안전한 무작위 값으로 교체 (미설정 시 dev 전용 기본값 사용)
JWT_SECRET=local-dev-secret-change-me-please-0123456789

# 구글 로그인 — Google Cloud Console(APIs & Services > Credentials)의 OAuth 클라이언트 id.
# 웹/안드로이드 등 여러 개면 쉼표로 나열. 미설정 시 구글 로그인 버튼만 비활성.
GOOGLE_CLIENT_IDS=

# 음식 사진 AI 분석 — Google AI Studio(https://aistudio.google.com)에서 무료 발급.
# 미설정 시 AI 분석 기능만 비활성화되고 나머지는 정상 동작한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_LIMIT_PER_USER=10

# 바코드 식품 DB 조회 — 식품안전나라 OpenAPI(https://various.foodsafetykorea.go.kr/nutrient)
# 무료 회원가입 후 즉시 발급. 미설정 시 바코드 조회 기능만 비활성화되고 나머지는 정상 동작한다.
FOOD_DB_API_KEY=
FOOD_DB_BASE_URL=http://openapi.foodsafetykorea.go.kr/api

# Cloudinary 서명(signed) 업로드 — 콘솔(Settings > API Keys)에서 확인.
# 미설정 시 프론트가 unsigned preset 업로드로 폴백한다 (docs/IMAGE_UPLOAD.md).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fitto

# 비밀번호 재설정 메일 — 발송 우선순위: Resend(HTTP) → SMTP → 로그 출력(개발 전용).
#
# [권장] Resend — Railway 등 PaaS 는 아웃바운드 SMTP(587)를 막아 Gmail SMTP 가
#   닿지 못한다. Resend 는 HTTPS(443)로 발송하므로 그 환경에서도 동작한다.
#   RESEND_API_KEY 만 넣으면 SMTP 설정보다 우선 사용된다.
#   RESEND_FROM 미설정 시 onboarding@resend.dev(도메인 인증 전 테스트용 — 가입 계정
#   이메일로만 발송 가능). 실제 사용자 발송은 Resend 에서 도메인 인증 후 주소 변경 필요.
RESEND_API_KEY=
RESEND_FROM=Doubly <onboarding@resend.dev>

# [폴백] SMTP — SMTP 아웃바운드가 열린 환경용. Gmail 사용 시 MAIL_PASSWORD 는 앱 비밀번호.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
